# Public frontend configuration.
# These values are embedded in the browser bundle, so only use the anon /
# publishable key here. Never put the service-role key in a VITE_ variable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Owner-only values, used by scripts in frontend/scripts.
# Not prefixed with VITE_, so Vite never exposes them to the website.
# The service-role key bypasses RLS: keep it out of Git and never use it in src/.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
